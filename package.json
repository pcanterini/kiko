{
  "name": "kiko",
  "version": "0.3.18",
  "description": "A voice controller for coding agents (Claude Code, Codex, OpenCode, T3 Code) on the Mac",
  "license": "MIT",
  "homepage": "https://kiko.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcanterini/kiko.git"
  },
  "bugs": {
    "url": "https://github.com/pcanterini/kiko/issues"
  },
  "private": true,
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.3"
  },
  "packageManager": "pnpm@11.17.0",
  "bin": {
    "kiko": "bin/kiko",
    "kiko-dev": "bin/kiko-dev"
  },
  "type": "module",
  "scripts": {
    "start": "node src/cli.ts",
    "start:tap": "KIKO_PTT_MODE=tap node src/cli.ts",
    "link:dev": "mkdir -p \"$HOME/.local/bin\" && ln -sfn \"$(pwd)/bin/kiko-dev\" \"$HOME/.local/bin/kiko-dev\" && echo \"Linked ~/.local/bin/kiko-dev to $(pwd)/bin/kiko-dev\"",
    "smoke": "node scripts/smoke.ts",
    "smoke:binary": "node scripts/ship/smoke.ts",
    "support": "node scripts/support-doc.ts",
    "build:native": "node src/platform/macos/native.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "node --test 'tests/unit/**/*.test.ts'",
    "test:live": "node --test --test-concurrency=1 'tests/live/**/*.test.ts'",
    "test:all": "pnpm test && pnpm test:live",
    "test:app": "bash tests/harness/run.sh",
    "test:e2e": "KIKO_E2E=1 node --test tests/live/cli/early-access-live.test.ts",
    "test:relay": "pnpm --dir relay typecheck && pnpm --dir relay test",
    "eval:routing": "node tests/eval/run.ts",
    "eval:summary": "node tests/eval/summary.ts",
    "eval:relay": "node tests/eval/relay/run.ts",
    "shadow:report": "node scripts/shadow-report.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && biome check . && pnpm test",
    "check:full": "pnpm check && pnpm test:app",
    "public:snapshot": "node scripts/public-snapshot.ts",
    "release:build": "sh scripts/release.sh",
    "ship": "node scripts/ship/ship.ts",
    "release:status": "node scripts/ship/status.ts",
    "release:notarize": "node scripts/ship/ship.ts notarize"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@clack/prompts": "^1.8.1",
    "@noble/ciphers": "2.4.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "jsqr": "1.4.0",
    "typescript": "^7.0.2"
  }
}
