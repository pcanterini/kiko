<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The `kiko` executable's entitlements (scripts/release.sh signs it with the hardened runtime).
  Bun's JavaScriptCore compiles hot code at run time: without allow-jit the hardened runtime turns
  its JIT off and everything still runs, only about twice as slow (measured 2026-11-01, Bun 1.4.4).
  allow-unsigned-executable-memory is what Bun's own signing guide adds beside it, kept for Intel
  Macs, where it couldn't be tried on real hardware. Nothing else: no native addons are loaded
  (so library validation stays on) and executable-page protection isn't needed.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
